# Copy to .env and fill with real local values (see README "Run it locally").
# .env is gitignored and must never be committed. Every key the Settings class
# reads is listed here.

# --- Relational + auth: local Supabase / Postgres, RLS forced. Required. ---
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- Owner door: Supabase login JWT verification. issuer + jwks_url required. ---
SUPABASE_JWT_ISSUER=http://127.0.0.1:54321/auth/v1
SUPABASE_JWKS_URL=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json
SUPABASE_JWT_AUDIENCE=authenticated

# --- MCP door: self-minted external-caller token. Signing secret required and
#     server-side only; audience is THIS server. A DIFFERENT credential domain
#     from the Supabase JWT above. ---
MCP_SIGNING_SECRET=replace-with-a-long-random-local-secret
MCP_TOKEN_ISSUER=honest-agent
MCP_TOKEN_AUDIENCE=honest-agent-mcp
MCP_ALLOWED_HOSTS=["127.0.0.1","localhost"]
MCP_ALLOWED_ORIGINS=["https://claude.ai"]

# --- Visitor door: max request body before the gate rejects it (bytes). ---
VISITOR_MAX_BODY_BYTES=65536

# --- Vector store: Weaviate, multi-tenancy on, hybrid search. Required. ---
WEAVIATE_URL=http://localhost:8080

# --- Supabase API and keys. service_role bypasses RLS, so it is a crown jewel:
#     server-side only, never in the browser or a CI log. ---
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key

# --- Gemini via Vertex AI, the only live model. The service-account JSON is the
#     one credential that can spend money. ---
GEMINI_MODEL=gemini-2.5-flash
VERTEX_CREDENTIALS_PATH=/path/to/vertex-service-account.json

# --- Observability. Both stay inert until set. ---
LOGFIRE_TOKEN=your-logfire-token
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# --- The only secret the widget bundle is allowed to carry. ---
WIDGET_PUBLIC_KEY=your-widget-public-key
